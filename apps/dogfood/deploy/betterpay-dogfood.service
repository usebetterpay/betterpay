[Unit]
Description=BetterPay dogfood (Acme AI credit dashboard)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ujang/projects/apps/usebetterpay/betterpay/apps/dogfood
Environment=PATH=/home/ujang/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/ujang
